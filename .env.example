# ============================================================
# CINEGA — .env.example (mẫu — KHÔNG ghi secret thật vào file này)
# Copy sang `.env` (dev) hoặc `.env.render` (để đưa lên Render).
# Các giá trị thật chỉ nằm trong `.env` (đã bị .gitignore).
# ============================================================

# ---- Node / runtime ----
NODE_ENV=development
PORT=3000

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- Auth (backend verify JWT) ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ---- TMDB (đồng bộ phim đang chiếu VN) ----
TMDB_API_KEY=

# ---- SePay webhook + bank (mock khi dev) ----
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
BANK_CODE=970422
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=CINEGA ENTERTAINMENT

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:5173
MOBILE_API_URL=http://localhost:3000/api

# ---- Web (Vite) — chỉ cần khi dev; để TRỐNG khi deploy (web dùng /api cùng origin) ----
VITE_API_URL=http://localhost:3000/api

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ---- PostgreSQL local (docker-compose, dev DB) ----
POSTGRES_DB=cinera
POSTGRES_USER=cinera
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_PORT=5432