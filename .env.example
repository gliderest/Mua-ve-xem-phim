# ============================================================
# CINÉRA — Cinema Ticket System — Environment Template
# Copy file này thành `.env` rồi điền giá trị thực.
# KHÔNG BAO GIỜ commit `.env` lên Git.
# ============================================================

# ---- Node / runtime ----
NODE_ENV=development
PORT=3000

# ---- Supabase (PostgreSQL + Storage + Realtime) ----
# Lấy từ: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ---- Auth ----
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ---- SePay webhook + bank (mock khi dev) ----
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
BANK_CODE=970422
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=CINERA

# ---- Frontend / Mobile ----
FRONTEND_URL=http://localhost:5173
MOBILE_API_URL=http://localhost:3000/api

# ---- Web (Vite) ----
VITE_API_URL=http://localhost:3000/api

# TMDB (phim đang chiếu VN — dùng cho web, đặt trong web/.env)
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ---- PostgreSQL local (docker-compose, chỉ cho dev) ----
POSTGRES_DB=cinera
POSTGRES_USER=cinera
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_PORT=5432