# CINEGA Backend — Environment Template
# Copy thành `.env` (không commit) hoặc đặt trên Render Environment.
NODE_ENV=development
PORT=3000

# Supabase (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Auth
JWT_SECRET=CHANGE_ME_RANDOM_STRING
JWT_EXPIRES_IN=7d

# SePay / bank (mock)
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
BANK_CODE=970422
BANK_ACCOUNT_NUMBER=1900123456789
BANK_ACCOUNT_NAME=CINEGA ENTERTAINMENT

# Frontend / CORS
FRONTEND_URL=http://localhost:5173

# TMDB (đồng bộ phim đang chiếu VN)
TMDB_API_KEY=