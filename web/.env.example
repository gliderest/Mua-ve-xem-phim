# CINÉRA Web (Vite) — Environment Template
# Lưu ý: chỉ biến có prefix VITE_ mới được public lên browser.
# API_URL của backend (dev local) — khi deploy đổi thành domain Render.
VITE_API_URL=http://localhost:3000/api

# TMDB (phim đang chiếu tại Việt Nam — region=VN)
# Đăng ký miễn phí tại https://www.themoviedb.org/settings/api
# API key (v3) dùng cho client-side. Access token (v4) dùng cho server-side.
VITE_TMDB_API_KEY=CHANGE_ME_YOUR_TMDB_API_KEY
VITE_TMDB_ACCESS_TOKEN=CHANGE_ME_YOUR_TMDB_READ_ACCESS_TOKEN
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p